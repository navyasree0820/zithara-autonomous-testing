# === G1 Environments ===
E2E_BASE_URL_BETA=https://beta.zithara.com
E2E_BASE_URL_APP=https://app.zithara.com
E2E_AUTH_API_BASE_URL=https://dev-api-campaign.zithara.com

# === G2 Test merchant credentials ===
E2E_USER=
E2E_PASSWORD=

# === G3 Auth (use one strategy) ===
# Strategy A (preferred): pre-minted session cookies
E2E_ID_TOKEN=
E2E_REFRESH_TOKEN=
# ISO expiry for id_token cookie (optional; defaults to +1h)
E2E_EXPIRY_ISO=

# Strategy B/C: fixed OTP / MFA when login requires verify-login
E2E_OTP=

# Optional: skip heavy critical flows while wiring auth
# SKIP_CAMPAIGN_DRAFT=1

# === G7 Supabase audit (this repo only — Playwright dossier reporter) ===
# Used by reporters/supabase-dossier-reporter.js. Not related to campaigns-frontend.
SUPABASE_URL=https://eimdqqydplusbjbpqyff.supabase.co
# Service role key from Supabase → Project Settings → API (required for dossier writes)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override bucket name (default playwright-dossiers)
SUPABASE_DOSSIER_BUCKET=playwright-dossiers

# === Run metadata ===
# local | ci | agent | nightly
E2E_TRIGGER=local
# Override git sha if not in a git checkout
# GIT_SHA=
